<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14(targetSdk 34) 起：foregroundServiceType 声明了哪个类型，
         就必须同时声明该类型对应的 FOREGROUND_SERVICE_* 权限。
         只写 FOREGROUND_SERVICE 会在 startForeground() 时抛 SecurityException。
         这里 specialUse 需要下面这条；同时保留 shortService 所需的只有上面那条。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Android 11+ 包可见性：声明后才能读取本机已安装应用列表（用于关联 App 与取本地图标） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
        <!-- 拍照：需要能解析到可处理 ACTION_IMAGE_CAPTURE 的相机应用 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>

    <application
        android:name="com.vaultkey.ui.VaultApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false">

        <!-- 启动页：自定义开屏图 + 动画，之后转解锁页 -->
        <activity android:name="com.vaultkey.ui.SplashActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <activity android:name="com.vaultkey.ui.UnlockActivity" android:exported="true" android:launchMode="singleTop"
            android:excludeFromRecents="true" android:theme="@style/AppTheme">
        </activity>
        <activity android:name="com.vaultkey.ui.RecoverActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.HealthActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.TagManagerActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.AttachActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.TransferActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.MainActivity" android:exported="false" android:launchMode="singleTop"/>
        <activity android:name="com.vaultkey.ui.EntryEditActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.vaultkey.ui.AutofillGuideActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.SaveActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@style/AppTheme"/>
        <activity android:name="com.vaultkey.ui.IconFillActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.SkinActivity" android:exported="false"/>
        <activity android:name="com.vaultkey.ui.CardOcrActivity" android:exported="true"
            android:label="识别卡片">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <activity android:name="com.vaultkey.ui.CardEditActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.vaultkey.ui.ImageViewActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen"/>
        <activity android:name="com.vaultkey.ui.AppPickerActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.vaultkey.ui.AssistActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true"/>

        <service android:name="com.vaultkey.service.VaultAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService"/>
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill"/>
        </service>

        <service android:name="com.vaultkey.service.FillAssistService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/assist"/>
        </service>
        <!-- 桌面小部件：点击直达搜索，不显示任何账号内容 -->
        <receiver
            android:name="com.vaultkey.widget.SearchWidget"
            android:exported="true"
            android:label="密盒速搜">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_search_info"/>
        </receiver>

        <!-- 悬浮窗服务。
             类型同时声明 shortService|specialUse，运行时只传 shortService：
             - shortService：本次用途是「浮出来取一次账号就走」，官方定义为短任务，
               无需任何类型专用权限，因此不会因为缺权限而崩溃
             - specialUse：兜底保留 + 已声明对应权限，即使某些路径回退到它也不会崩
             注意：startForeground() 运行时传入的类型必须是 manifest 声明的子集，
             否则抛 IllegalArgumentException。 -->
        <service android:name="com.vaultkey.service.FloatService"
            android:exported="false"
            android:foregroundServiceType="shortService|specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的辅助悬浮控件：在其点击后，于其他应用登录界面上方
                    显示该用户已授权的账号条目，用于复制填充，避免来回切换应用"/>
        </service>

    </application>
</manifest>
