<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标 · 前景层：金库转盘（vault dial）
  外圈金属环 + 刻度 + 内圈深色盘 + 四根辐条 + 中心青绿发光轴心。
  比盾牌更贴合"密盒 / 密码箱"的意象，金属与发光的对比也更有质感。
  全部内容落在中心 56dp 内，圆形裁切也不会被切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <!-- 中心光晕：让转盘看起来在发光 -->
  <path android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0">
    <aapt:attr name="android:fillColor">
      <radial-gradient android:centerX="54" android:centerY="54" android:gradientRadius="30">
        <item android:offset="0" android:color="#5500E8C8"/>
        <item android:offset="0.6" android:color="#1A00B8A0"/>
        <item android:offset="1" android:color="#00000000"/>
      </radial-gradient>
    </aapt:attr>
  </path>

  <!-- 外圈金属环：左上亮 → 右下暗 -->
  <path android:pathData="M54,54 m-27,0 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0"
      android:strokeLineJoin="round" android:strokeLineCap="round"
      android:strokeWidth="5.2">
    <aapt:attr name="android:strokeColor">
      <gradient android:startX="27" android:startY="27" android:endX="81" android:endY="81"
          android:type="linear">
        <item android:offset="0" android:color="#FFFFFFFF"/>
        <item android:offset="0.35" android:color="#FFD8E4EA"/>
        <item android:offset="0.7" android:color="#FF8FA0AB"/>
        <item android:offset="1" android:color="#FF5C6B76"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 环上高光弧：只描上半圈，做出金属反光 -->
  <path android:pathData="M31,40 A27,27 0 0 1 62,29.5"
      android:strokeWidth="2.2" android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <linear-gradient android:startX="31" android:startY="40" android:endX="62" android:endY="29"
          android:type="linear">
        <item android:offset="0" android:color="#00FFFFFF"/>
        <item android:offset="0.5" android:color="#CCFFFFFF"/>
        <item android:offset="1" android:color="#00FFFFFF"/>
      </linear-gradient>
    </aapt:attr>
  </path>

  <!-- 内圈深色盘 -->
  <path android:pathData="M54,54 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0">
    <aapt:attr name="android:fillColor">
      <radial-gradient android:centerX="47" android:centerY="46" android:gradientRadius="34">
        <item android:offset="0" android:color="#FF2A3944"/>
        <item android:offset="0.65" android:color="#FF151F27"/>
        <item android:offset="1" android:color="#FF080D12"/>
      </radial-gradient>
    </aapt:attr>
  </path>

  <!-- 内盘上缘细高光 -->
  <path android:pathData="M37.5,44.5 A21,21 0 0 1 56,33.2"
      android:strokeWidth="1.4" android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <linear-gradient android:startX="37" android:startY="45" android:endX="56" android:endY="33"
          android:type="linear">
        <item android:offset="0" android:color="#00FFFFFF"/>
        <item android:offset="1" android:color="#55FFFFFF"/>
      </linear-gradient>
    </aapt:attr>
  </path>

  <!-- 四根辐条：转盘的手柄 -->
  <path android:pathData="M54,54 L54,35 M54,54 L54,73 M54,54 L35,54 M54,54 L73,54"
      android:strokeWidth="4.4" android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <linear-gradient android:startX="35" android:startY="35" android:endX="73" android:endY="73"
          android:type="linear">
        <item android:offset="0" android:color="#FFF2F7F9"/>
        <item android:offset="1" android:color="#FF9DADB7"/>
      </linear-gradient>
    </aapt:attr>
  </path>

  <!-- 刻度：环与内盘之间的 8 个小点，增加精密感 -->
  <path android:fillColor="#B3FFFFFF"
      android:pathData="M54,28.6 a1.5,1.5 0 1,0 0.1,0 z M54,79.4 a1.5,1.5 0 1,0 0.1,0 z M28.6,54 a1.5,1.5 0 1,0 0.1,0 z M79.4,54 a1.5,1.5 0 1,0 0.1,0 z M36,36 a1.3,1.3 0 1,0 0.1,0 z M72,72 a1.3,1.3 0 1,0 0.1,0 z M72,36 a1.3,1.3 0 1,0 0.1,0 z M36,72 a1.3,1.3 0 1,0 0.1,0 z"/>

  <!-- 中心轴心：青绿发光 -->
  <path android:pathData="M54,54 m-7.2,0 a7.2,7.2 0 1,0 14.4,0 a7.2,7.2 0 1,0 -14.4,0">
    <aapt:attr name="android:fillColor">
      <radial-gradient android:centerX="51" android:centerY="51" android:gradientRadius="15">
        <item android:offset="0" android:color="#FF7FF0DC"/>
        <item android:offset="0.5" android:color="#FF00C4AB"/>
        <item android:offset="1" android:color="#FF00796B"/>
      </radial-gradient>
    </aapt:attr>
  </path>

  <!-- 轴心高光点 -->
  <path android:fillColor="#D9FFFFFF"
      android:pathData="M51.4,51.2 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"/>
</vector>
