<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标 · 背景层
  深海蓝黑渐变玻璃：左上柔光 + 右下暗角 + 双边框高光 + 底部青蓝环境光。
  比纯黑更有层次，又不会抢前景。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <!-- 主底：斜向渐变，上偏蓝青、下近墨黑 -->
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="14" android:startY="2" android:endX="94" android:endY="106"
          android:type="linear">
        <item android:offset="0" android:color="#FF1E3A48"/>
        <item android:offset="0.42" android:color="#FF12222C"/>
        <item android:offset="1" android:color="#FF060B0F"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 左上柔光 -->
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <radial-gradient android:centerX="24" android:centerY="16" android:gradientRadius="82">
        <item android:offset="0" android:color="#40FFFFFF"/>
        <item android:offset="0.5" android:color="#14FFFFFF"/>
        <item android:offset="1" android:color="#00000000"/>
      </radial-gradient>
    </aapt:attr>
  </path>

  <!-- 外边框高光 -->
  <path android:pathData="M1.4,1.4h105.2v105.2h-105.2z"
      android:strokeLineJoin="round" android:strokeLineCap="round"
      android:strokeWidth="1.8">
    <aapt:attr name="android:strokeColor">
      <gradient android:startX="0" android:startY="0" android:endX="108" android:endY="108"
          android:type="linear">
        <item android:offset="0" android:color="#66FFFFFF"/>
        <item android:offset="0.5" android:color="#18FFFFFF"/>
        <item android:offset="1" android:color="#0AFFFFFF"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 内框暗描边：形成双边框 -->
  <path android:pathData="M7,7h94v94h-94z"
      android:strokeLineJoin="round" android:strokeLineCap="round"
      android:strokeWidth="1">
    <aapt:attr name="android:strokeColor">
      <linear-gradient android:startX="0" android:startY="0" android:endX="0" android:endY="108"
          android:type="linear">
        <item android:offset="0" android:color="#2EFFFFFF"/>
        <item android:offset="1" android:color="#0AFFFFFF"/>
      </linear-gradient>
    </aapt:attr>
  </path>

  <!-- 底部青蓝环境光，呼应品牌色 -->
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <radial-gradient android:centerX="54" android:centerY="100" android:gradientRadius="58">
        <item android:offset="0" android:color="#3800D8BC"/>
        <item android:offset="0.65" android:color="#0E00B8A0"/>
        <item android:offset="1" android:color="#00000000"/>
      </radial-gradient>
    </aapt:attr>
  </path>
</vector>
